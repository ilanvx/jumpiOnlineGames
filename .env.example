# Copy this file to ".env" and fill in your own values. Never commit .env or share it.

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster
MONGODB_DB=jumpi

# Long random secret used to sign login cookies (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=3000

# Email (Resend, https://resend.com): the sign-up code and the welcome email.
# Without RESEND_API_KEY nobody is asked for an email code. Put the real key only in .env, never here.
RESEND_API_KEY=
# Who the email comes from. The domain must be verified in Resend (Domains). For a quick test you can use
# "Jumpi Games <onboarding@resend.dev>" (Resend then only delivers to your own Resend account's email).
MAIL_FROM=Jumpi Games <hello@jumpigames.com>
# The public address of the site (used for the picture and the button in the email)
PUBLIC_URL=https://jumpigames.com

# Discord (tools/discord + Pip in the game server). The token comes from discord.com/developers → your app → Bot.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# the app's "Public Key" (Developer Portal → General Information); needed for the ✅ button in #rules
DISCORD_PUBLIC_KEY=
# 1 only on the real (live) server: lets the game post gift codes / mod log / staff alerts and update the live counters
DISCORD_LIVE=0
