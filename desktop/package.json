{
  "name": "jumpi-games",
  "productName": "Jumpi Games",
  "version": "1.0.0",
  "description": "Jumpi Games - a 3D virtual world for kids",
  "author": "Jumpi Games <support@jumpigames.com>",
  "homepage": "https://jumpigames.com",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.jumpigames.desktop",
    "productName": "Jumpi Games",
    "copyright": "© 2026 Jumpi Games",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "splash-preload.js",
      "offline.html",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Jumpi-Games-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Jumpi Games",
      "uninstallDisplayName": "Jumpi Games",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ilanvx",
        "repo": "jumpiOnlineGames",
        "releaseType": "release"
      }
    ],
    "appx": {
      "identityName": "JumpiGames.JumpiGames3DWorld",
      "publisher": "CN=D1A5ED0C-E553-4DC9-807F-75C79F612D36",
      "publisherDisplayName": "JumpiGames",
      "applicationId": "JumpiGames",
      "displayName": "Jumpi Games: 3D World",
      "backgroundColor": "#1f8fff",
      "showNameOnTiles": true,
      "languages": [
        "en-US",
        "he-IL"
      ],
      "artifactName": "Jumpi-Games-Store.${ext}"
    }
  }
}
